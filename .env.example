# Copy to .env (gitignored) at the repo root. Every app reads this one file.
# Anything left empty falls back to a local double, so the demo path runs with an empty .env.

# --- agent model: Google Gemini key from AI Studio; optional AGENT_MODEL overrides the default gemini-3.8-flash ---
AGENT_API_KEY=

# --- storage: TigerData (Postgres) connection string, e.g. postgres://...?sslmode=require; empty -> in-memory ---
DATABASE_URL=

# --- ledger: local | nessie ---
LEDGER_BACKEND=local
NESSIE_KEY=               # classic API: key as ?key= query param
# NESSIE_API_KEY=         # v2 API: header auth instead
# NESSIE_SECRET=
NESSIE_VERSION=v1         # confirmed at INF-01: classic API over https

# --- Photon Spectrum (from `bun create spectrum-project`, or project Settings at app.photon.codes) ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# --- ElevenLabs (stretch: digest voice recap, phone negotiator) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- wiring ---
PBM_SIM_URL=http://localhost:8100
CLAIM_FEED_URL=http://localhost:8000/api/feed/claim   # where the PBM Sim switch tees paid claims
ADAPTER_MODE=direct       # direct (PBM Sim JSON door) | real (portal / email / fax adapters)
PHARMACY_ID=PH-MEADOWBROOK
PLATFORM_ACCOUNT=RXSOLVE-PLATFORM
PHARMACIST_PHONE=         # iMessage digest destination; must be a registered project user on shared lines
WHOLESALER_CONTACT=       # WhatsApp/SMS destination

# --- dev tooling: agent coordinator (tools/agent-coordinator) ---
COORDINATOR_URL=
COORDINATOR_BOX=
COORDINATOR_PASSWORD=
